+func TestM002ClaimedAccountDeletionRollback(t *testing.T) {
+	h := newAccountDeleteHarness(t)
+	f := h.seed(t, true)
+	// Fail after explicit claim cleanup, before account cascades; only this
+	// disposable test database receives the failure trigger.
+	if _, err := h.pool.Exec(h.ctx, `CREATE FUNCTION wordweave.reject_test_account_delete() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic account deletion failure'; END $$;
+ CREATE TRIGGER reject_test_account_delete BEFORE DELETE ON wordweave.accounts FOR EACH ROW EXECUTE FUNCTION wordweave.reject_test_account_delete()`); err != nil {
+		t.Fatal(err)
+	}
+	if err := h.api.identity.DeleteAccount(h.ctx, h.actor, accountDeletePassword, true); err == nil {
+		t.Fatal("injected deletion failure committed")
+	}
+	if _, reused, err := h.fresh().ConsumeClaim(h.ctx, h.actor, f.claim.Token); err != nil || !reused {
+		t.Fatalf("rolled-back deletion lost consumed claim: %v", err)
+	}
+	if _, err := h.fresh().BatchDetail(h.ctx, h.actor.ID, f.batch); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := h.pool.Exec(h.ctx, `DROP TRIGGER reject_test_account_delete ON wordweave.accounts; DROP FUNCTION wordweave.reject_test_account_delete()`); err != nil {
+		t.Fatal(err)
+	}
+	if err := h.api.identity.DeleteAccount(h.ctx, h.actor, accountDeletePassword, true); err != nil {
+		t.Fatal(err)
+	}
+}
