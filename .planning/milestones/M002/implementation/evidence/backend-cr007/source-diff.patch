+func newAccountDeleteHarness(t *testing.T) claimDeleteHarness {
+	t.Helper()
+	h := newClaimDeleteHarness(t)
+	hash, err := security.HashPassword(accountDeletePassword)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = h.pool.Exec(h.ctx, `UPDATE wordweave.accounts SET password_hash=$1 WHERE id=$2`, hash, h.actor.ID); err != nil {
+		t.Fatal(err)
+	}
+	return h
+}
