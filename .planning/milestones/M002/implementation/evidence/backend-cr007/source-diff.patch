+func TestM002ClaimedAccountDeletionBlocksClaimReplay(t *testing.T) {
+	h := newAccountDeleteHarness(t)
+	f := h.seed(t, true)
+	barrier := h.lockBatch(t, f.batch)
+	deleted := make(chan error, 1)
+	go func() { deleted <- h.api.identity.DeleteAccount(h.ctx, h.actor, accountDeletePassword, true) }()
+	h.waitBlocked(t, "DELETE FROM wordweave.accounts")
+	replayed := make(chan error, 1)
+	go func() { _, _, err := h.fresh().ConsumeClaim(h.ctx, h.actor, f.claim.Token); replayed <- err }()
+	h.waitBlocked(t, "SELECT id FROM wordweave.accounts")
+	if err := barrier.Rollback(h.ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-deleted; err != nil {
+		t.Fatal(err)
+	}
+	if err := <-replayed; err == nil {
+		t.Fatal("claim replay succeeded after account deletion")
+	}
+	var remaining int
+	if err := h.pool.QueryRow(h.ctx, `SELECT (SELECT count(*) FROM wordweave.accounts WHERE id=$1)+(SELECT count(*) FROM wordweave.learning_batches WHERE owner_id=$1)+(SELECT count(*) FROM wordweave.visitor_claims WHERE consumed_account_id=$1)`, h.actor.ID).Scan(&remaining); err != nil || remaining != 0 {
+		t.Fatalf("claim replay recreated deleted resources: %d %v", remaining, err)
+	}
