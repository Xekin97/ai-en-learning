      {
        "id": "e853685f-0867-4f23-af79-e059ecdd42cc",
        "title": "A small habit of learning",
        "published_version": "2f670747-3a93-45f1-aa6a-5acd750f2503",
        "version_created_at": "2026-09-29T10:25:10.077468+08:00",
        "configuration": {
          "model": {
            "id": "01a0eafa-f36c-7b77-9e14-c48c0aafdc15",
            "name": "MiniMax"
          },
          "entries": [
            "learn",
            "weave",
            "book"
          ],
          "meaning_language": "en",
          "scenario": "story",
          "length": "short"
        },
        "sample": {
          "passage": "A thoughtful student learns by building a steady learning routine through daily reading and discussion. Each morning the student reviews a few ideas, connects them with practical examples, and writes a short reflection. Friends later compare their observations, ask clear questions, and share useful explanations about what they learned. This patient practice makes new knowledge easier to remember and apply with confidence. During the afternoon, the group returns to a quiet room and examines an interesting question from several different perspectives. Everyone takes time to listen carefully before offering an explanation. At the end of the meeting, they choose one small activity to complete before their next conversation. Their shared effort turns an ordinary afternoon into a meaningful opportunity for discovery. They weave these ideas into a practical plan. A book helps them explore another example.",
          "tags": [
            "study"
          ],
