+/* UI24 — a centered, bounded notice index; rows fill their shared reading surface. */
+.notices-page { width: 100%; max-width: 880px; margin-inline: auto; }
+.notices-page .page-head { margin-bottom: 24px; }
+.notices-page .notice-list { max-width: none; margin: 0; padding: 0; list-style: none; background: var(--paper); border: 1px solid var(--line); border-radius: 20px; }
+.notices-page .notice-list > li { margin: 0; padding: 0; list-style: none; }
+.notices-page .notice-list > li + li { border-top: 1px solid var(--line); }
+.notices-page .notice-entry { display: grid; grid-template-columns: 100px minmax(0,1fr) 22px; align-items: center; gap: 24px; width: 100%; min-height: 104px; padding: 24px; margin: 0; border: 0; border-radius: 0; background: transparent; color: var(--ink); text-align: left; cursor: pointer; transition: background-color var(--motion) var(--ease); }
+.notices-page li:first-child .notice-entry { border-radius: 19px 19px 0 0; }
+.notices-page li:last-child .notice-entry { border-radius: 0 0 19px 19px; }
+.notices-page li:only-child .notice-entry { border-radius: 19px; }
+.notices-page .notice-entry:hover { background: #f0f4e7; }
+.notices-page .notice-entry:focus-visible { outline: 3px solid var(--green); outline-offset: -4px; background: #f0f4e7; }
+.notice-entry-date { color: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.notice-entry-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 9px; min-width: 0; }
+.notice-entry-title { font-size: 18px; line-height: 1.6; font-weight: 650; overflow-wrap: anywhere; }
+.notices-page .notice-entry-badge { padding: 3px 9px; font-size: 11px; line-height: 1.5; font-weight: 500; }
+.notice-entry-arrow.ui-icon { width: 20px; height: 20px; color: var(--green); }
+.notice-empty { padding: 12px; background: var(--paper); border: 1px solid var(--line); border-radius: 20px; }
+@media (max-width: 600px) {
+  .notices-page .page-head { margin-bottom: 18px; }
+  .notices-page .notice-entry { grid-template-columns: minmax(0,1fr) 20px; gap: 9px 14px; min-height: 0; padding: 18px; }
+  .notice-entry-date { grid-column: 1; grid-row: 1; font-size: 12px; }
+  .notice-entry-copy { grid-column: 1; grid-row: 2; gap: 8px; }
+  .notice-entry-arrow.ui-icon { grid-column: 2; grid-row: 1 / span 2; }
+  .notice-entry-title { font-size: 17px; }
+}
