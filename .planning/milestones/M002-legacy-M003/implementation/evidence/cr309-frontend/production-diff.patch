+}
+
+/* UI11 / CR-309: one vocabulary and reading surface across Plan and Result. */
+.m003-vocabulary-panel {
+  min-width: 0;
+}
+.m003-vocabulary-panel .m003-vocabulary-list {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 0 24px;
+  margin: 0;
 }
+.m003-vocabulary-panel .m003-vocabulary-list > div {
+  min-width: 0;
+  padding: 10px 0;
+  border-top: 1px solid var(--line);
+}
+.m003-vocabulary-panel .m003-vocabulary-list dt {
+  color: var(--green-dark);
+  font: 600 17px/1.4 var(--reading);
+  overflow-wrap: anywhere;
+}
+.m003-vocabulary-panel .m003-vocabulary-list dd {
+  margin: 4px 0 0;
+  color: var(--muted);
+  font-size: 13px;
+  line-height: 1.65;
+  overflow-wrap: anywhere;
+}
+.m003-plan-meanings {
+  margin-top: 14px;
+}
+.m003-live-draft .story-text,
+.m003-final-result .story-text,
+.m003-preview-paper .story-text {
+  width: 100%;
+  max-width: none;
+  margin: 18px 0 14px;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  line-height: 1.85;
+}
+@media (max-width: 760px) {
+  .m003-vocabulary-panel .m003-vocabulary-list {
+    grid-template-columns: 1fr;
+  }
+  .m003-live-draft .story-text,
+  .m003-final-result .story-text,
+  .m003-preview-paper .story-text {
+    line-height: 1.78;
+  }
+}
