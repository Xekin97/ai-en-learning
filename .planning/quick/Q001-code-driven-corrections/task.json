  "plan": [
    "串行履行产品与后端架构责任，回落当前增量契约",
    "实现代码诊断、受限模板及响应合并，保留全量最终校验",
    "确定性功能与生成管线回归；QA、交接、compact 与 finish"
  ],
  "acceptance": [
    {
      "id": "AC1",
      "description": "代码识别多字段错误并组合兼容模板；区分词形缺失、标注缺失、未知关系及启发式语言检查",
      "verification": "command"
    },
    {
      "id": "AC2",
      "description": "动态键由服务端映射，严格拒绝重复/缺失/多余/空或类型错误响应；不依赖键顺序且纠正不公开流式内容",
      "verification": "command"
    },
    {
      "id": "AC3",
      "description": "有效字段仅合并到私有候选，剩余错误反馈重试；正文可见文本不变，hint模式约束正确",
      "verification": "command"
    },
    {
      "id": "AC4",
      "description": "纠正及续写共享最多两次预算；取消/传输故障不重试，既有生成管线和终态校验回归通过",
      "verification": "command"
    },
    {
      "id": "AC5",
      "description": "修改在声明范围内，未改里程碑控制面、用户研究文件、公开接口和现有质量保留项",
      "verification": "inspection"
    }
  ],
