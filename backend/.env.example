POSTGRES_PASSWORD=replace-with-local-database-password
PUBLIC_ORIGIN=http://localhost:3000
HTTP_ADDR=:8080
METRICS_ADDR=:9090
APP_DATABASE_URL=postgres://postgres:replace-with-local-database-password@postgres:5432/wordweave?sslmode=disable
AI_DATABASE_URL=postgres://postgres:replace-with-local-database-password@postgres:5432/wordweave?sslmode=disable
SESSION_PEPPER=replace-with-at-least-32-bytes
CAPABILITY_PEPPER=replace-with-at-least-32-bytes
CSRF_HMAC_KEY=replace-with-at-least-32-bytes
CURSOR_HMAC_KEY=replace-with-at-least-32-bytes
OPENROUTER_MASTER_KEYS=1:<base64-encoded-32-byte-key>
OPENROUTER_CURRENT_KEY_VERSION=1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
COOKIE_SECURE=false
LOG_LEVEL=info
APP_DB_MAX_CONNS=4
AI_DB_MAX_CONNS=4
TRUSTED_PROXY_CIDRS=172.30.0.0/24

# Optional admin dashboard link only; no private-page tracking is injected.
CLARITY_PROJECT_ID=
# Explicit operator connection for activate-growth (set outside runtime secrets).
# MAINTENANCE_DATABASE_URL=
