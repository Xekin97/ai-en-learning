{
  "name": "wordweave-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:boundaries": "depcruise app --config dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@nuxtjs/i18n": "10.6.0",
    "eventsource-parser": "4.1.0",
    "nuxt": "4.5.2",
    "vue": "3.5.42",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.2.0",
    "@playwright/test": "1.62.1",
    "@testing-library/vue": "8.1.0",
    "@vue/test-utils": "2.5.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@types/node": "26.4.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "happy-dom": "20.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
