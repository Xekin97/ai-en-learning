COMPOSE_PROJECT_NAME=wordweave
WORDWEAVE_PORT=3000
POSTGRES_DB=wordweave
POSTGRES_USER=postgres

# Local single-slot values only. Production must set explicitly validated capacities;
# do not treat these development values as measured production capacity.
SHUTDOWN_TIMEOUT=650s
GENERATION_MAX_IN_FLIGHT=1
PREVIEW_MAX_IN_FLIGHT=1
GENERATION_PROBE_MAX_IN_FLIGHT=1
GENERATION_PREFLIGHT_MAX=1
AI_CONNECTION_MAX_IN_FLIGHT=1
AI_CONNECTION_DEFAULT_CAPACITY_GROUP=local-provider-account
AI_CONNECTION_CAPACITY_GROUPS={}
GENERATION_BUSY_RETRY_AFTER=5s

